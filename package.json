{
  "name": "@o3co/auth.proxy",
  "description": "Proxy to validate authorization token",
  "packageManager": "pnpm@10.29.3",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "dependencies": {
    "@o3co/auth.utils": "^0.0.4",
    "@o3co/ts.hocon": "^1.2.0",
    "cors": "2.8.x",
    "cross-env": "10.1.x",
    "express": "^5.2.1",
    "express-http-proxy": "^2.1.2",
    "jsonwebtoken": "9.0.x",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-http-proxy": "^1.6.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "25.9.x",
    "@types/supertest": "^7.2.0",
    "debug": "4.4.3",
    "pino": "^10.3.1",
    "supertest": "^7.2.2",
    "tsx": "^4.22.3",
    "typescript": "5.9.x",
    "vitest": "^4.1.6"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "format": "prettier --write \"**/*.{js,ts,json,mjs,yml}\"",
    "audit": "pnpm audit --audit-level=high",
    "test": "vitest run",
    "debug": "tsx src/app.mts",
    "start": "node dist/src/app.mjs"
  }
}
